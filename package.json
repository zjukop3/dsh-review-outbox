{
  "name": "dsh-review-outbox",
  "version": "0.1.10",
  "description": "Evidence-gated acceptance for DeepSeek Harness deliverables: research reports need claims, citations, data scope and method limits checked with written evidence before approval, spreadsheets need source, units and a spot check; approvals produce a standalone SHA-256 receipt that says when the reviewed bytes moved.",
  "type": "module",
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deliverables",
    "review",
    "research-report",
    "citation-review",
    "acceptance",
    "review-receipt",
    "workflow",
    "evidence-gate",
    "research-report-acceptance",
    "deliverable-review",
    "研究报告",
    "验收"
  ],
  "license": "MIT",
  "author": "zjukop3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zjukop3/dsh-review-outbox.git"
  },
  "homepage": "https://zjukop3.github.io/dsh-review-outbox/",
  "bugs": {
    "url": "https://github.com/zjukop3/dsh-review-outbox/issues"
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "build:market": "node scripts/build-market-index.mjs",
    "test": "node --test test/*.test.js",
    "test:browser": "node scripts/e2e-browser.mjs",
    "test:browser:backfill": "node scripts/e2e-backfill-browser.mjs",
    "test:browser:restart": "node scripts/e2e-backfill-restart.mjs",
    "test:browser:research": "node scripts/e2e-research-receipt.mjs",
    "test:browser:native": "node scripts/e2e-native-viewer.mjs",
    "test:browser:better": "node scripts/e2e-better-sidebar.mjs",
    "test:browser:github": "node scripts/e2e-github-source.mjs",
    "test:browser:catalog": "node scripts/e2e-catalog-install.mjs",
    "test:browser:catalog:listing": "node scripts/e2e-catalog-listing.mjs",
    "test:browser:market": "node scripts/e2e-application-market.mjs",
    "test:browser:recovery": "node scripts/e2e-cleanpack-recovery.mjs",
    "test:interop:research": "node --experimental-transform-types scripts/e2e-research-report-interop.mjs",
    "seed:official": "node scripts/seed-official-backfill.mjs",
    "check": "node scripts/build-market-index.mjs && npm test && npm run build",
    "report:ecosystem": "node scripts/ecosystem-snapshot.mjs --cache docs/metrics/ecosystem-downloads.json"
  },
  "files": [
    "src",
    "client",
    "dist/client.js",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "LICENSE",
    "assets/storefront",
    "assets/icon-180.png",
    "docs/**/*.md"
  ],
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.2-rc.1",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-present": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tool-testkit": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.2-rc.1",
    "playwright-core": "^1.64.1",
    "tsdown": "^0.22.2"
  }
}
